# ---------------------------------------------------------------------------
# SelfStorage frontend — API configuration
# ---------------------------------------------------------------------------

# Base URL the BROWSER uses for API calls.
# Leave as "/api" (recommended) to go through the Next.js same-origin proxy,
# which avoids all CORS issues. Set a full URL only if you want the browser to
# call the backend directly (that backend then must send CORS headers).
NEXT_PUBLIC_API_URL=/api

# Where the Next.js server forwards "/api/*" requests (server-side only,
# never exposed to the browser).
API_PROXY_TARGET=http://localhost:5000
